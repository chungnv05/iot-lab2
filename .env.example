# ===== MQTT =====
# Broker công cộng (không cần tài khoản). Nếu dùng HiveMQ Cloud: đổi host, port 8883, điền user/pass.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Mã nhóm - PHẢI trùng GROUP_ID trong firmware/wokwi/sketch.ino. Đặt tên riêng để không lẫn với nhóm khác.
MQTT_GROUP=nhom15

# ===== InfluxDB 2.x =====
INFLUX_URL=http://localhost:8086
# INFLUX_TOKEN được script scripts/setup_influxdb.py tự điền
INFLUX_TOKEN=
INFLUX_ORG=ptit
BUCKET_RAW=iot_raw
BUCKET_PROCESSED=iot_processed
RETENTION_RAW_DAYS=7
RETENTION_PROCESSED_DAYS=30
